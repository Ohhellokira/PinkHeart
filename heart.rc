#include "resource.h"
#include <winver.h>

IDI_APPICON ICON "icon.ico"

IDR_LOVE_YOU_MP3 RCDATA "love_you.mp3"
IDR_ICON_PNG RCDATA "icon_64.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Ohhellokira, Serenity"
            VALUE "FileDescription", "I Love You Chloe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "heart.exe"
            VALUE "LegalCopyright", "Ohhellokira, Serenity"
            VALUE "OriginalFilename", "heart.exe"
            VALUE "ProductName", "Blue Heart"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
